{
  "name": "kayy-office",
  "version": "1.3.0",
  "private": true,
  "description": "Pixel office overlay for Claude Code agents (Windows)",
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "mock": "tsx tools/mock-events.ts",
    "icon": "tsx tools/make-icon.ts",
    "perf": "tsx tools/perf-check.ts",
    "dist": "npm run build && electron-builder",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "author": "Kaajaa03"
}
