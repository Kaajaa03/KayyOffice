  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
