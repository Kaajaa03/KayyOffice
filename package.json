{
  "name": "kayy-office",
  "version": "0.1.0",
  "private": true,
  "description": "Pixel office overlay for Claude Code agents (Windows)",
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "start": "npm run build && electron .",
